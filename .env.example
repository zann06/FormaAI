# FormaAI — environment configuration
#
# Copy to `.env` and fill in the required values:
#   cp .env.example .env
#
# Required for any non-development run are marked REQUIRED. Everything else has
# a safe default; leave it commented out unless you need to change it.
#
# FormaAI is bring-your-own-key: there is NO platform-wide AI API key. Each user
# adds their own provider credential in the app, and it is encrypted at rest with
# CREDENTIAL_ENCRYPTION_KEY.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# development | test | production
NODE_ENV=production

# Public origin of the web app. Used for cookie/CSRF decisions and links.
# For docker compose the web container is published on this origin.
WEB_ORIGIN=http://localhost:8080

# Set to true when running behind a reverse proxy (nginx, Caddy, Traefik) so the
# client IP and protocol are read from X-Forwarded-* headers.
# TRUST_PROXY=true

# fatal | error | warn | info | debug | trace | silent
# LOG_LEVEL=info

# Never enable in production: logs document text, which may be confidential.
# LOG_DOCUMENT_CONTENT=false

# ---------------------------------------------------------------------------
# Secrets (REQUIRED in production — the API refuses to start without them)
# ---------------------------------------------------------------------------
# 32-byte key used to encrypt stored provider API keys (AES-256-GCM).
# Generate with:  openssl rand -base64 32
# (hex also accepted:  openssl rand -hex 32)
# Rotate later with:  npm run rotate-key --workspace @formaai/api
CREDENTIAL_ENCRYPTION_KEY=

# At least 32 characters; used to derive the session-token hashing pepper.
# Generate with:  openssl rand -hex 32
SESSION_SECRET=

# Mark session cookies Secure. Set true when you serve over HTTPS.
# COOKIE_SECURE=false

# Optional cookie domain, e.g. .example.com for subdomain-wide sessions.
# COOKIE_DOMAIN=

# SESSION_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# postgres://USER:PASSWORD@HOST:5432/DATABASE
# docker compose builds this from POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB.
DATABASE_URL=postgres://formaai:change-me@localhost:5432/formaai

# Required when your Postgres provider enforces TLS (most managed services).
# DATABASE_SSL=false
# DATABASE_POOL_MAX=10

# Used only by docker compose to create the Postgres container.
POSTGRES_USER=formaai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=formaai

# Host port for the web container in docker compose.
# WEB_PORT=8080

# ---------------------------------------------------------------------------
# Registration / access
# ---------------------------------------------------------------------------
# Set false to close public sign-up on a private instance.
# REGISTRATION_ENABLED=true

# Comma-separated emails granted the operator role (usage/health only; operators
# get no access to other users' documents).
# ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# local | s3
# STORAGE_DRIVER=local
# STORAGE_DIR=./data/storage

# Required when STORAGE_DRIVER=s3 (works with any S3-compatible service:
# AWS S3, Cloudflare R2, MinIO, Backblaze B2, ...).
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Limits and quotas (per user)
# ---------------------------------------------------------------------------
# MAX_FILE_MB=25
# MAX_PDF_PAGES=300
# USER_STORAGE_QUOTA_MB=1024
# DAILY_AI_REQUEST_QUOTA=500
#   AI requests per user per calendar day (UTC). This is a cost guard, not a
#   provider limit: one report of 40+ sections needs well over 500 calls, so
#   raise it if a single report cannot finish in one day.
# DAILY_EXPORT_QUOTA=50

# ---------------------------------------------------------------------------
# PDF conversion (optional — DOCX export never needs this)
# ---------------------------------------------------------------------------
# Path to the LibreOffice binary for local conversion. The Docker image sets
# LIBREOFFICE_BIN=soffice for you.
# LIBREOFFICE_BIN=soffice
#
# ...or a remote converter service that accepts DOCX and returns PDF.
# CONVERTER_URL=
# CONVERTER_TOKEN=
# PDF_CONVERSION_TIMEOUT_MS=120000

# ---------------------------------------------------------------------------
# AI providers
# ---------------------------------------------------------------------------
# Development only: enables the deterministic offline provider used by tests and
# demos. Never enable on a public instance — it produces placeholder text, not
# real analysis.
# ENABLE_DEV_PROVIDER=false
#
# AI_REQUEST_TIMEOUT_MS=90000
# AI_MAX_EVIDENCE_CHARS=14000
# AI_MAX_SECTIONS_PER_JOB=40
# AI_STRUCTURED_REPAIR_ATTEMPTS=1

# ---------------------------------------------------------------------------
# Background jobs
# ---------------------------------------------------------------------------
# Runs the job worker inside the API process. Disable only if you run a separate
# worker against the same database.
# WORKER_ENABLED=true
# WORKER_CONCURRENCY=2
# JOB_MAX_ATTEMPTS=3

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# RATE_LIMIT_MAX=300
# RATE_LIMIT_WINDOW=1 minute

# ---------------------------------------------------------------------------
# Retention
# ---------------------------------------------------------------------------
# EXPORT_RETENTION_DAYS=30
