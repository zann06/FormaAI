# Dependencies
node_modules/
.npm/

# Build output
dist/
build/
*.tsbuildinfo

# Environment and secrets — never commit real keys
.env
.env.*
!.env.example
*.pem
*.key

# Local data (uploads, generated exports, local DB volumes)
#
# `storage/` is anchored to the repository root on purpose. Written as a bare
# `storage/` pattern it matches at *any* depth, which silently swallowed
# apps/api/src/services/storage/ — the storage adapter the API imports. Nothing
# failed locally because those files were still on disk, but a fresh clone could
# not compile, so CI failed on its first real run.
#
# `data/` and `uploads/` stay unanchored because STORAGE_DIR defaults to
# `./data/storage` *relative to each workspace*, so runtime output shows up at
# any depth and must never be committed. No source directory is named either.
/storage/
data/
uploads/

# Generated sample documents (regenerate with: npm run fixtures)
fixtures/*.docx
fixtures/*.pdf
fixtures/*.txt

# Logs
*.log
npm-debug.log*

# Test and tooling caches
coverage/
.vitest/
.nyc_output/
.cache/

# Editor and OS noise
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Scratch / probe files used during development
probe*.ts
probe*.log

# Throwaway Chrome profile used by scripts/capture-screenshots.mjs
.chrome-profile/

# Documentation kept locally but not published. README.md is the single
# Markdown document in the repository; the rest stay on disk for the author.
CODE_OF_CONDUCT.md
CONTRIBUTING.md
MASTER_PROMPT.md
SECURITY.md
docs/*.md
